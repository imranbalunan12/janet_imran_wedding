# Required on Vercel for persistent RSVPs (Vercel Storage -> Neon sets this for you).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Code guests type after "Open Invitation"
INVITE_CODE=FOREVER2027

# Secret code that unlocks the RSVP admin dashboard at /admin
ADMIN_CODE=IMRANJANET-ADMIN

# Optional: YouTube video ID for the prenup film (the part after v=)
NEXT_PUBLIC_PRENUP_YOUTUBE_ID=

# Signs the guest/admin cookies. Any long random text.
SESSION_SECRET=
